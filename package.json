{
  "name": "web-3d-component",
  "version": "0.0.0",
  "author": "omanoel",
  "license": "ISC",
  "description": "Webcomponent web-3d-component following open-wc recommendations",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./web-3d-component.js": "./dist/src/web-3d-component.js"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && npm run analyze -- --exclude dist && vite build",
    "preview": "vite preview",
    "analyze": "cem analyze --litelement",
    "prepublish": "tsc && npm run analyze -- --exclude dist",
    "lint": "eslint --ext .ts,.html . --ignore-path .gitignore && prettier \"**/*.ts\" --check --ignore-path .gitignore",
    "format": "eslint --ext .ts,.html . --fix --ignore-path .gitignore && prettier \"**/*.ts\" --write --ignore-path .gitignore",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omanoel/web-3d-component.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/omanoel/web-3d-component/issues"
  },
  "homepage": "https://github.com/omanoel/web-3d-component#readme",
  "dependencies": {
    "lit": "^3.1.4",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.3",
    "@open-wc/eslint-config": "^12.0.3",
    "@types/three": "^0.172.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "tslib": "^2.6.3",
    "typescript": "^5.5.3",
    "vite": "^6.0.11"
  },
  "customElements": "custom-elements.json",
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "extends": [
      "@open-wc",
      "prettier"
    ],
    "plugins": [
      "@typescript-eslint"
    ],
    "rules": {
      "no-unused-vars": "off",
      "@typescript-eslint/no-unused-vars": [
        "warn"
      ],
      "import/no-unresolved": "off",
      "import/extensions": [
        "warn",
        "ignorePackages",
        {
          "js": "never",
          "jsx": "never",
          "ts": "never",
          "tsx": "never"
        }
      ]
    }
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 120,
    "arrowParens": "avoid"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}